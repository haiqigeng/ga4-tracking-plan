{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GA4 tracking-plan business change request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_version", "change_id", "description", "change_type", "selectors"],
  "properties": {
    "request_version": {"const": "1.0.0"},
    "change_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "description": {"type": "string", "minLength": 1},
    "change_type": {"enum": ["journey_shape", "value_domain", "event_semantic", "datalayer_convention", "other"]},
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "journey_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "opportunity_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "event_names": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "value_domain_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "scope"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "scope": {"enum": ["event", "item", "user", "implementation"]},
              "event_names": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "added_values": {"type": "array", "uniqueItems": true},
              "removed_values": {"type": "array", "uniqueItems": true}
            }
          }
        }
      }
    }
  }
}
