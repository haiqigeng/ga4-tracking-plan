{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rendered website discovery report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "discovery_version",
    "report_id",
    "generated_at",
    "root_url",
    "outcome",
    "rounds",
    "language_summary",
    "pages_sampled",
    "measurement_opportunity_hints",
    "journey_coverage_ledger",
    "coverage_gaps",
    "automatic_interaction_runs"
  ],
  "properties": {
    "discovery_version": {"enum": ["1.1.0", "1.2.0", "1.3.0", "1.4.0"]},
    "run_id": {"type": "string", "pattern": "^run_[a-f0-9]{32}$"},
    "report_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "root_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "outcome": {"enum": ["completed", "partial", "blocked"]},
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round_number",
          "attempted_page_count",
          "usable_page_count",
          "new_candidate_count",
          "material_unvisited_candidate_count",
          "stop_reason"
        ],
        "properties": {
          "round_number": {"type": "integer", "minimum": 1},
          "attempted_page_count": {"type": "integer", "minimum": 0},
          "usable_page_count": {"type": "integer", "minimum": 0},
          "new_candidate_count": {"type": "integer", "minimum": 0},
          "material_unvisited_candidate_count": {"type": "integer", "minimum": 0},
          "stop_reason": {
            "enum": [
              "continue_targeted_discovery",
              "material_coverage_complete",
              "candidate_queue_exhausted",
              "max_rounds_reached",
              "blocked",
              "session_expired"
            ]
          },
          "phase_id": {"type": "string", "minLength": 1},
          "access_profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "language_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_language", "observed_languages", "evidence_urls"],
      "properties": {
        "primary_language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
        "observed_languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"}
        },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        }
      }
    },
    "pages_sampled": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "template"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "template": {"type": "string", "minLength": 1},
          "classification_diagnostic": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primary", "confidence", "candidates"],
            "properties": {
              "primary": {"type": "string", "minLength": 1},
              "confidence": {"enum": ["high", "medium", "low"]},
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["template", "score", "reasons"],
                  "properties": {
                    "template": {"type": "string", "minLength": 1},
                    "score": {"type": "integer", "minimum": 1},
                    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
                  }
                }
              }
            }
          },
          "interaction_capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capability_id", "family", "category", "materiality", "reason", "evidence"],
              "properties": {
                "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
                "family": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
                "category": {"enum": ["outcome", "progression", "diagnostic", "interaction", "context"]},
                "materiality": {"enum": ["material", "candidate"]},
                "reason": {"type": "string", "minLength": 1},
                "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "language": {"type": "string"},
          "rendered_structure_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "rendered_dom_sha256": {"type": "string", "pattern": "^(?:[a-f0-9]{64})?$"}
        }
      }
    },
    "measurement_opportunity_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hint_id",
          "hint_key",
          "journey_id",
          "variant_id",
          "category",
          "materiality",
          "evidence_urls",
          "evidence_structure_hashes",
          "reason",
          "requires_interactive_review"
        ],
        "properties": {
          "hint_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "hint_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "journey_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "category": {"enum": ["outcome", "progression", "diagnostic", "interaction", "context"]},
          "materiality": {"enum": ["material", "candidate"]},
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uri"}
          },
          "evidence_structure_hashes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "reason": {"type": "string", "minLength": 1},
          "capability_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"}
          },
          "requires_interactive_review": {"type": "boolean"}
        }
      }
    },
    "journey_coverage_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "journey_id",
          "material",
          "status",
          "entry_points",
          "states_covered",
          "evidence_urls",
          "variant_coverage"
        ],
        "properties": {
          "journey_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "material": {"type": "boolean"},
          "status": {"enum": ["observed", "partial", "not_tested", "externally_blocked", "blocked"]},
          "entry_points": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "states_covered": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "anyOf": [
                {"enum": ["entry", "progression", "submission", "success", "failure", "empty", "post_conversion"]},
                {"type": "string", "pattern": "^interaction:[a-z][a-z0-9_]{1,79}$"}
              ]
            }
          },
          "evidence_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "variant_coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variant_id",
                "material",
                "status",
                "entry_points",
                "states_covered",
                "evidence_urls",
                "unvisited_material_candidates"
              ],
              "properties": {
                "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
                "access_profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
                "role": {"type": "string", "minLength": 1},
                "state_id": {"type": "string", "minLength": 1},
                "material": {"type": "boolean"},
                "status": {"enum": ["observed", "partial", "not_tested", "externally_blocked", "blocked"]},
                "entry_points": {"type": "array", "items": {"type": "string", "format": "uri"}},
                "states_covered": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "anyOf": [
                      {"enum": ["entry", "progression", "submission", "success", "failure", "empty", "post_conversion"]},
                      {"type": "string", "pattern": "^interaction:[a-z][a-z0-9_]{1,79}$"}
                    ]
                  }
                },
                "evidence_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
                "unvisited_material_candidates": {"type": "array", "items": {"type": "string", "format": "uri"}}
              }
            }
          }
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["gap_id", "material", "description"],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "journey_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "recipe_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
          "form_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "material": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "evidence_state": {"enum": ["not_tested", "partial", "externally_blocked"]},
          "candidate_urls": {"type": "array", "items": {"type": "string", "format": "uri"}}
        }
      }
    },
    "automatic_interaction_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["recipe_id", "journey_id", "variant_id", "start_url", "outcome", "actions"],
        "properties": {
          "recipe_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
          "journey_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "start_url": {"type": "string", "format": "uri"},
          "outcome": {"enum": ["completed", "partial", "blocked", "stopped_before_consequential_action"]},
          "evidence_state": {
            "enum": [
              "inventory_observed",
              "progression_observed",
              "failure_observed",
              "submission_observed",
              "success_confirmed"
            ]
          },
          "evidence_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim", "evidence_type", "locator", "evidence"],
              "properties": {
                "claim": {
                  "enum": [
                    "inventory_observed",
                    "progression_observed",
                    "failure_observed",
                    "submission_observed",
                    "success_confirmed"
                  ]
                },
                "evidence_type": {"type": "string", "minLength": 1},
                "locator": {"type": "string", "minLength": 1},
                "evidence": {"type": "object", "minProperties": 1}
              }
            }
          },
          "actions": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "interaction_probe_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "probe_id",
          "capability_id",
          "family",
          "start_url",
          "access_profile_id",
          "role",
          "outcome",
          "evidence_state",
          "evidence_claims",
          "actions"
        ],
        "properties": {
          "probe_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
          "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
          "family": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "start_url": {"type": "string", "format": "uri"},
          "access_profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "role": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["observed", "completed", "partial", "blocked"]},
          "evidence_state": {
            "enum": [
              "inventory_observed",
              "progression_observed",
              "failure_observed",
              "submission_observed",
              "success_confirmed"
            ]
          },
          "evidence_claims": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "actions": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "access_profile_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "profile_id",
          "role",
          "access_method",
          "entry_urls",
          "allowed_hosts",
          "attempt_count",
          "status",
          "final_disposition"
        ],
        "properties": {
          "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "role": {"type": "string", "minLength": 1},
          "access_method": {"enum": ["storage_state", "login_recipe", "headful_handoff", "public_registration"]},
          "entry_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "allowed_hosts": {"type": "array", "items": {"type": "string"}},
          "attempt_count": {"type": "integer", "minimum": 1, "maximum": 2},
          "status": {"enum": ["authenticated_discovery_completed", "session_expired", "externally_blocked"]},
          "final_disposition": {"type": "string", "minLength": 1}
        }
      }
    },
    "side_effect_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["side_effect_type", "access_profile_id", "role", "persistent_external_artifact_possible", "contains_synthetic_identity"],
        "properties": {
          "side_effect_type": {"type": "string", "minLength": 1},
          "access_profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "role": {"type": "string", "minLength": 1},
          "recipe_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
          "persistent_external_artifact_possible": {"const": true},
          "contains_synthetic_identity": {"const": false}
        }
      }
    },
    "finite_value_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "journey_id",
          "variant_id",
          "source_label",
          "capture_status",
          "complete",
          "observed_value_count",
          "captured_value_count",
          "values",
          "evidence_urls"
        ],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
          "journey_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "source_label": {"type": "string", "minLength": 1},
          "capture_status": {"enum": ["complete", "incomplete", "over_50"]},
          "complete": {"type": "boolean"},
          "observed_value_count": {"type": "integer", "minimum": 1},
          "captured_value_count": {"type": "integer", "minimum": 1, "maximum": 50},
          "values": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label"],
              "properties": {
                "value": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1}
              }
            }
          },
          "evidence_urls": {"type": "array", "items": {"type": "string", "format": "uri"}}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"discovery_version": {"enum": ["1.2.0", "1.3.0", "1.4.0"]}},
        "required": ["discovery_version"]
      },
      "then": {
        "properties": {
          "coverage_gaps": {
            "items": {"required": ["evidence_state"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"discovery_version": {"enum": ["1.3.0", "1.4.0"]}},
        "required": ["discovery_version"]
      },
      "then": {
        "required": ["run_id"]
      }
    },
    {
      "if": {
        "properties": {"discovery_version": {"const": "1.4.0"}},
        "required": ["discovery_version"]
      },
      "then": {
        "required": ["interaction_probe_runs", "access_profile_runs", "side_effect_log"],
        "properties": {
          "pages_sampled": {
            "items": {
              "allOf": [
                {
                  "if": {"not": {"required": ["fetch_error"]}},
                  "then": {"required": ["rendered_structure_sha256", "rendered_dom_sha256"]}
                }
              ]
            }
          },
          "automatic_interaction_runs": {
            "items": {
              "required": ["evidence_claims"],
              "allOf": [
                {
                  "if": {
                    "properties": {"outcome": {"const": "completed"}},
                    "required": ["outcome"]
                  },
                  "then": {
                    "required": ["evidence_state"],
                    "properties": {"evidence_state": {"const": "success_confirmed"}}
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
