{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal GA4 tracking-plan evidence and coverage context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_state",
    "scope_claim",
    "sources",
    "journey_coverage",
    "coverage_gaps",
    "value_domains"
  ],
  "properties": {
    "target_state": {
      "enum": ["as_is", "to_be", "hybrid"]
    },
    "scope_claim": {
      "enum": ["whole_site", "journey_subset"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "reference",
          "evidence_role",
          "state",
          "supports"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "source_type": {
            "enum": [
              "live_website",
              "user_input",
              "business_document",
              "design_specification",
              "gtm_container",
              "datalayer",
              "technical_specification",
              "previous_tracking_plan",
              "analytics_export",
              "other"
            ]
          },
          "reference": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "evidence_role": {
            "enum": [
              "live_behavior",
              "business_requirement",
              "future_design",
              "current_implementation",
              "data_capability",
              "historical_contract",
              "data_usage"
            ]
          },
          "state": {"enum": ["as_is", "to_be", "both"]},
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "conflicts": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "journey_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "journey_id",
          "material",
          "status",
          "evidence_refs",
          "entry_points",
          "states_covered"
        ],
        "properties": {
          "journey_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "material": {"type": "boolean"},
          "status": {
            "enum": ["observed", "confirmed", "planned", "partial", "blocked"]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "entry_points": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "states_covered": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "entry",
                "progression",
                "success",
                "failure",
                "empty",
                "post_conversion"
              ]
            }
          },
          "variants": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "notes": {"type": "string"}
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "material", "resolution", "description"],
        "properties": {
          "gap_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "journey_id": {"type": "string", "minLength": 1},
          "material": {"type": "boolean"},
          "resolution": {
            "enum": ["confirmed_elsewhere", "excluded", "blocked", "unresolved"]
          },
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "value_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain_id",
          "parameter_name",
          "scope",
          "kind",
          "evidence_refs"
        ],
        "properties": {
          "domain_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "parameter_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "scope": {"enum": ["event", "item", "user", "implementation"]},
          "event_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "kind": {"enum": ["finite", "dynamic"]},
          "complete": {"type": "boolean"},
          "values": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {"type": ["string", "number", "integer", "boolean"]}
          },
          "rule": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"kind": {"const": "finite"}},
              "required": ["kind"]
            },
            "then": {"required": ["complete", "values"]}
          },
          {
            "if": {
              "properties": {"kind": {"const": "dynamic"}},
              "required": ["kind"]
            },
            "then": {"required": ["rule"]}
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "official_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "checked_for"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "checked_for": {"type": "string", "minLength": 1},
          "checked_at": {"type": "string", "format": "date-time"},
          "content_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    }
  }
}
