{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal GA4 tracking-plan evidence and coverage context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_state",
    "scope_claim",
    "language_decision",
    "sources",
    "discovery_reports",
    "journey_coverage",
    "coverage_gaps",
    "measurement_opportunities",
    "value_domains"
  ],
  "properties": {
    "context_version": {"enum": ["1.0.0", "1.1.0"]},
    "run_id": {"type": "string", "pattern": "^run_[a-f0-9]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "target_state": {
      "enum": ["as_is", "to_be", "hybrid"]
    },
    "scope_claim": {
      "enum": ["whole_site", "journey_subset"]
    },
    "language_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "basis",
        "evidence_refs",
        "observed_website_languages",
        "reasoning"
      ],
      "properties": {
        "language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
        "basis": {"enum": ["user", "template", "team", "audience", "website"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observed_website_languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"}
        },
        "reasoning": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "reference",
          "evidence_role",
          "state",
          "supports"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "source_type": {
            "enum": [
              "live_website",
              "user_input",
              "business_document",
              "design_specification",
              "gtm_container",
              "datalayer",
              "technical_specification",
              "previous_tracking_plan",
              "analytics_export",
              "measurement_framework",
              "other"
            ]
          },
          "reference": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "evidence_role": {
            "enum": [
              "live_behavior",
              "business_requirement",
              "future_design",
              "current_implementation",
              "data_capability",
              "historical_contract",
              "data_usage"
            ]
          },
          "state": {"enum": ["as_is", "to_be", "both"]},
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "conflicts": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "framework_intake": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_format",
              "quality_status",
              "applicable_material_refs"
            ],
            "properties": {
              "artifact_format": {
                "enum": ["canonical_json", "markdown_only"]
              },
              "schema_version": {"type": "string", "minLength": 1},
              "quality_status": {
                "enum": ["pass", "pass_with_exceptions", "fail", "unknown"]
              },
              "applicable_material_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "applicability_reason": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {
                "if": {
                  "properties": {"artifact_format": {"const": "canonical_json"}},
                  "required": ["artifact_format"]
                },
                "then": {"required": ["schema_version"]}
              },
              {
                "if": {
                  "properties": {"applicable_material_refs": {"maxItems": 0}},
                  "required": ["applicable_material_refs"]
                },
                "then": {"required": ["applicability_reason"]}
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"source_type": {"const": "measurement_framework"}},
              "required": ["source_type"]
            },
            "then": {
              "required": ["framework_intake"],
              "properties": {
                "evidence_role": {"const": "business_requirement"}
              }
            },
            "else": {
              "not": {"required": ["framework_intake"]}
            }
          }
        ]
      }
    },
    "discovery_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report_id",
          "source_id",
          "reference",
          "sha256",
          "outcome",
          "hint_ids",
          "journey_ids",
          "variant_ids"
        ],
        "properties": {
          "report_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
          "run_id": {"type": "string", "pattern": "^run_[a-f0-9]{32}$"},
          "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "reference": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "generated_at": {"type": "string", "format": "date-time"},
          "outcome": {"enum": ["completed", "partial", "blocked"]},
          "hint_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"}
          },
          "journey_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"}
          },
          "variant_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"}
          }
        }
      }
    },
    "journey_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "journey_id",
          "material",
          "status",
          "evidence_refs",
          "entry_points",
          "states_covered",
          "opportunity_ids"
        ],
        "properties": {
          "journey_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "material": {"type": "boolean"},
          "status": {
            "enum": ["observed", "confirmed", "planned", "partial", "not_tested", "externally_blocked", "blocked"]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "entry_points": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "states_covered": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "entry",
                "progression",
                "success",
                "failure",
                "empty",
                "post_conversion"
              ]
            }
          },
          "opportunity_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,79}$"
            }
          },
          "variants": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "variant_coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variant_id",
                "material",
                "status",
                "evidence_refs",
                "entry_points",
                "states_covered"
              ],
              "properties": {
                "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
                "material": {"type": "boolean"},
                "status": {"enum": ["observed", "confirmed", "planned", "partial", "not_tested", "externally_blocked", "blocked"]},
                "evidence_refs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "entry_points": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "states_covered": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"enum": ["entry", "progression", "success", "failure", "empty", "post_conversion"]}
                },
                "notes": {"type": "string"}
              }
            }
          },
          "notes": {"type": "string"}
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "material", "resolution", "description"],
        "properties": {
          "gap_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "journey_id": {"type": "string", "minLength": 1},
          "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "recipe_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
          "form_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
          "material": {"type": "boolean"},
          "resolution": {
            "enum": ["confirmed_elsewhere", "excluded", "blocked", "unresolved"]
          },
          "evidence_state": {
            "enum": ["not_tested", "partial", "externally_blocked"]
          },
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "measurement_opportunities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opportunity_id",
          "journey_id",
          "name",
          "category",
          "material",
          "evidence_status",
          "evidence_refs",
          "business_question",
          "official_candidate",
          "official_fit",
          "decision",
          "decision_reason",
          "event_names",
          "discovery_hint_ids"
        ],
        "properties": {
          "opportunity_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "journey_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "variant_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "name": {"type": "string", "minLength": 1},
          "category": {
            "enum": ["outcome", "progression", "diagnostic", "interaction", "context"]
          },
          "material": {"type": "boolean"},
          "evidence_status": {
            "enum": ["observed", "confirmed", "planned", "not_tested", "externally_blocked", "blocked"]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_locations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "locator"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "locator": {"type": "string", "minLength": 1},
                "component": {"type": "string", "minLength": 1}
              }
            }
          },
          "business_question": {"type": "string", "minLength": 1},
          "official_candidate": {"type": "string", "minLength": 1},
          "official_fit": {"enum": ["fit", "gap", "not_applicable"]},
          "decision": {"enum": ["measure", "covered_elsewhere", "exclude", "unresolved"]},
          "decision_reason": {"type": "string", "minLength": 1},
          "event_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,39}$"
            }
          },
          "discovery_hint_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,79}$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"decision": {"const": "measure"}},
              "required": ["decision"]
            },
            "then": {
              "properties": {"event_names": {"minItems": 1}}
            }
          },
          {
            "if": {
              "properties": {"decision": {"const": "exclude"}},
              "required": ["decision"]
            },
            "then": {
              "properties": {"event_names": {"maxItems": 0}}
            }
          },
          {
            "if": {
              "properties": {"decision": {"const": "covered_elsewhere"}},
              "required": ["decision"]
            },
            "then": {
              "properties": {"event_names": {"maxItems": 0}}
            }
          }
        ]
      }
    },
    "value_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain_id",
          "parameter_name",
          "scope",
          "kind",
          "normalization",
          "evidence_refs"
        ],
        "properties": {
          "domain_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          },
          "parameter_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "scope": {"enum": ["event", "item", "user", "implementation"]},
          "event_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "kind": {"enum": ["finite", "dynamic"]},
          "normalization": {
            "enum": [
              "controlled_semantic",
              "official_enum",
              "technical_identifier",
              "authoritative_raw",
              "numeric",
              "boolean",
              "structured"
            ]
          },
          "value_language": {
            "type": "string",
            "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
          },
          "complete": {"const": true},
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {"type": ["string", "number", "integer", "boolean"]}
          },
          "value_labels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label", "language"],
              "properties": {
                "value": {"type": ["string", "number", "integer", "boolean"]},
                "label": {"type": "string", "minLength": 1},
                "language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"}
              }
            }
          },
          "label_generation_rule": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "dynamic_reason": {
            "enum": [
              "free_text",
              "identifier",
              "url",
              "changing_inventory",
              "over_50",
              "structured",
              "not_observable"
            ]
          },
          "observed_value_count": {"type": "integer", "minimum": 0},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"kind": {"const": "finite"}},
              "required": ["kind"]
            },
            "then": {"required": ["complete", "values"]}
          },
          {
            "if": {
              "properties": {"kind": {"const": "dynamic"}},
              "required": ["kind"]
            },
            "then": {"required": ["rule", "dynamic_reason"]}
          },
          {
            "if": {
              "properties": {
                "normalization": {"const": "controlled_semantic"},
                "kind": {"const": "finite"}
              },
              "required": ["normalization", "kind"]
            },
            "then": {"required": ["value_language", "value_labels"]}
          },
          {
            "if": {
              "properties": {
                "normalization": {"const": "controlled_semantic"},
                "kind": {"const": "dynamic"}
              },
              "required": ["normalization", "kind"]
            },
            "then": {"required": ["value_language", "label_generation_rule"]}
          },
          {
            "if": {
              "properties": {"dynamic_reason": {"const": "over_50"}},
              "required": ["dynamic_reason"]
            },
            "then": {
              "required": ["observed_value_count"],
              "properties": {"observed_value_count": {"minimum": 51}}
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "official_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "checked_for"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "checked_for": {"type": "string", "minLength": 1},
          "checked_at": {"type": "string", "format": "date-time"},
          "content_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    }
  }
}
