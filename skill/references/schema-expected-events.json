{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GA4 tracking-plan expected-events handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plan_version", "data_layer_convention", "events"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "plan_version": {"type": "string", "minLength": 1},
    "data_layer_convention": {"type": "object"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_name", "classification", "journey_ids", "trigger", "locations", "clear_before_push", "push_schema", "parameters"],
        "properties": {
          "event_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$"},
          "classification": {"enum": ["official", "official_ecommerce", "custom", "context"]},
          "journey_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "business_question": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1},
          "locations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "clear_before_push": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "push_schema": {"type": "string", "pattern": "^schemas/[a-z][a-z0-9_]{1,39}\\.schema\\.json$"},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "scope", "type", "requirement", "data_layer_path", "destination"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "scope": {"enum": ["event", "item", "user", "implementation"]},
                "type": {"enum": ["string", "integer", "number", "boolean", "array", "object"]},
                "requirement": {"enum": ["required", "conditional", "optional"]},
                "condition": {"type": "string", "minLength": 1},
                "data_layer_path": {"type": "string", "minLength": 1},
                "destination": {"enum": ["ga4_event_parameter", "ga4_item_parameter", "ga4_user_property", "ga4_user_id", "implementation_only"]}
              }
            }
          }
        }
      }
    }
  }
}
